# Copy to .env and fill in. Never commit .env.

# --- Core ---
ENVIRONMENT=dev
# SQLite for dev; Postgres URL for prod, e.g.
# postgresql+psycopg://user:pass@localhost:5432/steadycorp
DATABASE_URL=sqlite:///./steadycorp.db

# --- Auth (stateful session-id, stored in Redis) ---
# session lifetime in minutes (default 7 days)
SESSION_TTL_MINUTES=10080
REDIS_URL=redis://localhost:6379/0

# --- Drop / claim tuning ---
# minutes a claimed brick is held before it returns to available
BRICK_HOLD_MINUTES=10
BRICKS_PER_DROP=20

# --- Quiz gate (K-of-N threshold) ---
QUIZ_QUESTIONS_PER_RUN=6
QUIZ_REQUIRED_CORRECT=3
QUIZ_SECONDS_PER_QUESTION=10

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Stripe (TEST mode) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM=drops@steadycorp.example
